---
import Base from "@/layouts/Base.astro";
import type { L } from "@/data/content";
import { withBase } from "@/lib/paths";
import { content } from "@/data/content";

interface Props {
  lang: L;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const c = content[lang];
const zh = lang === "zh";
const p = c.product;
---
<Base lang={lang} pathname={pathname} pageKey="product">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1 class="page-hero__title">{p.hero.title}</h1>
      <p class="page-hero__sub">{p.hero.sub}</p>
    </div>
  </section>

  {p.sections.map((sec, i) => (
    <section class:list={["section", { "section--soft": i % 2 === 1 }]}>
      <div class="container split split--reverse-none">
        <div class="split__media reveal">
          <div class="mock">
            <div class="mock__bar"></div>
            <div class="mock__line w75"></div>
            <div class="mock__line w60"></div>
            <div class="mock__line w45"></div>
            <div class="mock__line w30"></div>
            <div class="mock__chips">
              <span class="chip"></span>
              <span class="chip"></span>
              <span class="chip"></span>
            </div>
          </div>
        </div>
        <div class="reveal">
          <span class={["tag", `tag--${sec.accent === "connect" ? "accent" : "muted"}`]}>
            {sec.eyebrow}
          </span>
          <h2 class="split__title">{sec.title}</h2>
          <p class="split__text">{sec.text}</p>
          <ul class="bullets">
            {sec.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section class="section section--soft">
    <div class="container">
      <div class="section__head section__head--center">
        <span class="eyebrow">{p.featureTable.eyebrow}</span>
        <h2 class="section__title">{p.featureTable.title}</h2>
        <p class="section__sub">{p.featureTable.sub}</p>
      </div>
      <div class="table-wrap reveal">
        <table class="feat">
          <thead>
            <tr>
              {p.featureTable.headers.map((h) => <th scope="col">{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {p.featureTable.rows.map((row) => (
              <tr>
                {row.map((cell, ci) => <td>{ci === 0 ? <strong>{cell}</strong> : cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="section__more">
        <a href={withBase(zh ? "/contact/" : "/en/contact/")} class="btn btn--primary">
          {zh ? "预约演示，看看如何落地" : "Book a demo"}
          <span class="btn__arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .split__title {
    font-size: clamp(24px, 2.8vw, 34px);
    margin: 14px 0;
  }
  .split__text {
    color: var(--ink-soft);
    font-size: 16px;
  }
  .mock__chips {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .chip {
    flex: 1;
    height: 72px;
    border-radius: 12px;
    background: linear-gradient(160deg, rgba(31, 79, 216, 0.14), rgba(31, 79, 216, 0.05));
    border: 1px solid rgba(31, 79, 216, 0.15);
  }
  .table-wrap {
    overflow-x: auto;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .feat {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .feat th {
    text-align: left;
    padding: 16px 20px;
    background: var(--bg-soft);
    color: var(--ink-soft);
    font-weight: 600;
    white-space: nowrap;
  }
  .feat td {
    padding: 14px 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    vertical-align: top;
  }
  .feat td strong {
    color: var(--ink);
    white-space: nowrap;
  }
  .feat tbody tr:hover {
    background: #fafcff;
  }
  @media (max-width: 720px) {
    .feat th,
    .feat td {
      padding: 12px 14px;
    }
  }
</style>
