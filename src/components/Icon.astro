---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24 } = Astro.props;

const stroke = "fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";

const icons: Record<string, string> = {
  agent: `<path ${stroke} d="M12 3 3 8v8l9 5 9-5V8l-9-5z"/><path ${stroke} d="M3 8l9 5 9-5"/><path ${stroke} d="M12 13v8"/>`,
  rag: `<circle ${stroke} cx="12" cy="12" r="9"/><circle ${stroke} cx="12" cy="12" r="2"/><path ${stroke} d="M12 3a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6"/><path ${stroke} d="M12 5v2"/>`,
  skill: `<path ${stroke} d="M12 20h9"/><path ${stroke} d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>`,
  connect: `<rect ${stroke} x="2" y="7" width="7" height="10" rx="2"/><rect ${stroke} x="15" y="7" width="7" height="10" rx="2"/><path ${stroke} d="M9 12h6"/>`,
  desktop: `<rect ${stroke} x="2" y="4" width="20" height="13" rx="2"/><path ${stroke} d="M8 21h8M12 17v4"/>`,
  mobile: `<rect ${stroke} x="7" y="2" width="10" height="20" rx="2"/><path ${stroke} d="M11 18h2"/>`,
  browser: `<rect ${stroke} x="2" y="4" width="20" height="16" rx="2"/><path ${stroke} d="M2 9h20M6 7h.01M9 7h.01"/>`,
  wps: `<path ${stroke} d="M12 3v18M12 3 5 9v11h14V9L12 3z"/><path ${stroke} d="M9 14h6"/>`,
  im: `<path ${stroke} d="M21 11.5a8.5 8.5 0 0 1-9 8.5 8.7 8.7 0 0 1-3-.6L3 21l1.6-4.4A8.4 8.4 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/>`,
  api: `<path ${stroke} d="M4 8l4-4M20 8l-4-4M4 16l4 4M20 16l-4 4"/><rect ${stroke} x="8" y="8" width="8" height="8" rx="2"/>`,
  download: `<path ${stroke} d="M12 3v12m0 0 4-4m-4 4-4-4"/><path ${stroke} d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>`,
  doc: `<path ${stroke} d="M6 2h9l4 4v16H6z"/><path ${stroke} d="M15 2v4h4M9 12h6M9 16h5"/>`,
  arrow: `<path ${stroke} d="M4 12h16m0 0-6-6m6 6-6 6"/>`,
  check: `<path ${stroke} d="M4 12.5l5 5L20 6.5"/>`,
  shield: `<path ${stroke} d="M12 3l8 3v6c0 4.5-3 8-8 9-5-1-8-4.5-8-9V6l8-3z"/><path ${stroke} d="M9 12l2 2 4-4"/>`,
  star: `<path ${stroke} d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.2l5.9-.9L12 3z"/>`,
};

const body = icons[name] ?? icons.check;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class={Astro.props.class}
  aria-hidden="true"
  set:html={body}
/>
