---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import type { L } from "@/data/content";
import { withBase } from "@/lib/paths";
import { content, DOC_URL } from "@/data/content";

interface Props {
  lang: L;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const c = content[lang];
const zh = lang === "zh";
const d = c.download;
---
<Base lang={lang} pathname={pathname} pageKey="download">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="eyebrow">{d.hero.eyebrow}</span>
      <h1 class="page-hero__title">{d.hero.title}</h1>
      <p class="page-hero__sub">{d.hero.sub}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">{zh ? "体验版" : "Trial Edition"}</span>
        <h2 class="section__title">{d.intro}</h2>
      </div>

      <div class="grid grid--2 reveal">
        {d.items.map((item) => (
          <article class="card dl">
            <div class="dl__head">
              <div class="card__icon">
                <Icon name={item.id.startsWith("desktop") ? "desktop" : item.id === "mobile" ? "mobile" : item.id === "browser" ? "browser" : "wps"} size={26} />
              </div>
              <span class:list={["status-pill", item.status === "ok" ? "status-pill--ok" : "status-pill--soon"]}>
                {item.status === "ok" ? (zh ? "可下载" : "Available") : (zh ? "即将上线" : "Coming soon")}
              </span>
            </div>
            <h3 class="card__title">{item.name}</h3>
            <p class="card__text">{item.description}</p>
            <ul class="dl__meta">
              <li><span>{item.platform}</span>{item.note}</li>
              {item.meta.map((m) => <li>{m}</li>)}
            </ul>
            <div class="dl__action">
              {item.status === "ok" ? (
                <a href={item.href?.startsWith("http") ? item.href : withBase(item.href || "#")} class="btn btn--primary btn--block" data-dl={item.id}>
                  <Icon name="download" size={18} />
                  {item.primary}
                </a>
              ) : (
                <button type="button" class="btn btn--primary btn--block btn--disabled" disabled>
                  {item.primary}
                </button>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container grid grid--2">
      <div class="reveal">
        <span class="eyebrow">{d.version.title}</span>
        <h2 class="section__title">{zh ? "版本与使用文档" : "Version & documentation"}</h2>
        <p class="section__sub">{d.version.update}</p>
        <div class="dl__doc">
          <div class="card__icon">
            <Icon name="doc" size={26} />
          </div>
          <div>
            <h3 class="card__title">{d.version.docTitle}</h3>
            <p class="card__text">{d.version.docNote}</p>
            <a class="dl__doc-link" href={DOC_URL}>
              {zh ? "打开使用说明书" : "Open the user guide"}
              <span class="btn__arrow">→</span>
            </a>
          </div>
        </div>
      </div>
      <div class="reveal">
        <span class="eyebrow">{d.requirementTitle}</span>
        <h2 class="section__title">{zh ? "推荐配置" : "Recommended setup"}</h2>
        <ul class="bullets">
          {d.requirements.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <h2 class="cta-band__title">{d.demoNote.title}</h2>
          <p class="cta-band__text">{d.demoNote.text}</p>
        </div>
        <div class="cta-band__actions">
          <a href={withBase(zh ? "/contact/" : "/en/contact/")} class="btn btn--accent">
            {d.demoNote.cta}
            <span class="btn__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .dl__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
  }
  .dl__meta {
    list-style: none;
    margin: 16px 0 20px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 13px;
    color: var(--ink-faint);
  }
  .dl__meta li span {
    display: inline-block;
    font-weight: 600;
    color: var(--ink);
    margin-right: 6px;
  }
  .dl__action {
    margin-top: auto;
  }
  .card.dl {
    display: flex;
    flex-direction: column;
  }
  .dl__doc {
    margin-top: 22px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    display: flex;
    gap: 18px;
  }
  .dl__doc .card__text {
    margin-bottom: 10px;
  }
  .dl__doc-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
    color: var(--brand);
  }
  @media (max-width: 640px) {
    .dl__doc {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
