---
import Base from "@/layouts/Base.astro";
import HeroCarousel from "@/components/HeroCarousel.astro";
import Icon from "@/components/Icon.astro";
import type { L } from "@/data/content";
import { withBase } from "@/lib/paths";
import { content } from "@/data/content";

interface Props {
  lang: L;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const c = content[lang];
const zh = lang === "zh";
---
<Base lang={lang} pathname={pathname} pageKey="home">
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy reveal">
        <span class="eyebrow hero__eyebrow">{c.hero.eyebrow}</span>
        <p class="hero__brand">{c.siteName}</p>
        <h1 class="hero__title">
          {c.hero.title} <span class="hero__title-accent">{c.hero.titleHighlight}</span>
        </h1>
        <p class="hero__sub">{c.hero.sub}</p>
        <div class="hero__actions">
          <a href={withBase(zh ? "/contact/" : "/en/contact/")} class="btn btn--accent btn--lg">
            {c.hero.ctaPrimary}
            <span class="btn__arrow">→</span>
          </a>
          <a href={withBase(zh ? "/product/" : "/en/product/")} class="btn btn--ghost-light btn--lg">
            {c.hero.ctaSecondary}
            <span class="btn__arrow">→</span>
          </a>
        </div>
      </div>
      <HeroCarousel
        slides={c.hero.slides}
        label={zh ? "产品效果" : "Product"}
        prevLabel={zh ? "上一张" : "Previous"}
        nextLabel={zh ? "下一张" : "Next"}
        imageLabel={zh ? "图片" : "Image"}
        videoLabel={zh ? "视频" : "Video"}
      />
      <div class="hero__trust reveal">
        {c.hero.trust.map((t) => (
          <span class="trust__item">
            <Icon name="shield" size={16} />
            {t}
          </span>
        ))}
      </div>
    </div>
    <div class="hero__glow" aria-hidden="true"></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">{c.capabilities.eyebrow}</span>
        <h2 class="section__title">{c.capabilities.title}</h2>
        <p class="section__sub">{c.capabilities.sub}</p>
      </div>
      <div class="grid grid--2 reveal">
        {c.capabilities.cards.map((card) => (
          <article class="card">
            <div class="card__icon">
              <Icon name={card.icon} size={26} />
            </div>
            <h3 class="card__title">{card.title}</h3>
            <p class="card__text">{card.text}</p>
          </article>
        ))}
      </div>
      <div class="section__more">
        <a href={withBase(zh ? "/product/" : "/en/product/")} class="btn btn--ghost">
          {c.capabilities.cta}
          <span class="btn__arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__head section__head--center">
        <span class="eyebrow">{c.channels.eyebrow}</span>
        <h2 class="section__title">{c.channels.title}</h2>
        <p class="section__sub">{c.channels.sub}</p>
      </div>
      <div class="grid grid--3 reveal">
        {c.channels.items.map((item) => (
          <article class="card">
            <div class="card__icon">
              <Icon name={item.icon} size={26} />
            </div>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__text">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head section__head--center">
        <span class="eyebrow">{c.solutions.eyebrow}</span>
        <h2 class="section__title">{c.solutions.title}</h2>
        <p class="section__sub">{c.solutions.sub}</p>
      </div>
      <div class="grid grid--2 reveal">
        {c.solutions.cases.map((item) => (
          <article class="card">
            <div class="card__case-head">
              <span class="tag">{item.industry}</span>
              {item.placeholder && <span class="tag tag--accent">{zh ? "示例" : "Sample"}</span>}
            </div>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__text">{item.text}</p>
          </article>
        ))}
      </div>
      <div class="section__more">
        <a href={withBase(zh ? "/solutions/" : "/en/solutions/")} class="btn btn--ghost">
          {c.solutions.cta}
          <span class="btn__arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <h2 class="cta-band__title">{zh ? "预约一场面向贵司场景的演示" : "Book a demo for your scenario"}</h2>
          <p class="cta-band__text">{zh ? "可指定信贷营销、智能运维或平台治理议程。我们的专家将结合你的业务场景规划落地路径。" : "Choose credit marketing, ops decisioning, or platform governance — we will map a path around your scenario."}</p>
        </div>
        <div class="cta-band__actions">
          <a href={withBase(zh ? "/contact/" : "/en/contact/")} class="btn btn--accent">
            {c.hero.ctaPrimary}
            <span class="btn__arrow">→</span>
          </a>
          <a href={withBase(zh ? "/product/" : "/en/product/")} class="btn btn--ghost-light">
            {c.hero.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(1200px 500px at 85% -10%, rgba(31, 79, 216, 0.5), transparent 60%),
      radial-gradient(900px 420px at -10% 10%, rgba(232, 72, 47, 0.25), transparent 55%),
      linear-gradient(160deg, #172a5e 0%, #0b1730 60%);
    color: #fff;
    padding: 108px 0 56px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__copy {
    max-width: 800px;
  }
  .hero__eyebrow {
    background: rgba(157, 180, 255, 0.14);
  }
  .hero__brand {
    margin: 0 0 14px;
    font-size: clamp(28px, 4.2vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #fff;
  }
  .hero__title {
    font-size: clamp(28px, 4.2vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 22px;
    font-weight: 650;
    color: #d7e0f6;
  }
  .hero__title-accent {
    color: #7aa0ff;
    position: relative;
  }
  .hero__sub {
    font-size: clamp(16px, 1.9vw, 19px);
    color: #bfcbe6;
    max-width: 640px;
  }
  .hero__actions {
    margin-top: 34px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero__actions .btn--lg {
    padding: 15px 30px;
    font-size: 16px;
  }
  .hero__trust {
    margin-top: 56px;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .hero__glow {
    display: none;
  }
  .section__more {
    margin-top: 36px;
    text-align: center;
  }
  .card__case-head {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }
</style>
