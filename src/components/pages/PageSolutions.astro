---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import type { L } from "@/data/content";
import { content } from "@/data/content";

interface Props {
  lang: L;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const c = content[lang];
const zh = lang === "zh";
const s = c.solutions;
const scenarios = zh
  ? [
      { icon: "skill", title: "银行信贷 AI 营销", text: "用智能体连接客户洞察、产品策略与触达动作。建行天津分行为首批试点行；典型场景包括家装分期业务中的商户智能推荐。" },
      { icon: "connect", title: "智能运维决策系统", text: "面向银行与大型企业运维：告警收敛、根因与影响分析、处置协同与运维问答。已在东亚银行落地。" },
      { icon: "agent", title: "企业 AI 转型服务（FDE）", text: "前线部署工程师深入客户现场，共同定义场景、接入系统、打磨 Skills 与治理策略，缩短从试点到规模化的路径。" },
      { icon: "shield", title: "对号入座", text: "要增长选信贷营销；要稳态选智能运维；要组织级转型从 FDE 开始，先定场景地图与治理基线。" },
    ]
  : [
      { icon: "skill", title: "Bank credit AI marketing", text: "Connect insight, product strategy and outreach. CCB Tianjin is an early pilot; a typical scenario is merchant recommendation for home-renovation installments." },
      { icon: "connect", title: "Intelligent ops decisioning", text: "Alert clustering, RCA, impact analysis, remediation and ops Q&A — live at Bank of East Asia." },
      { icon: "agent", title: "Enterprise AI transformation (FDE)", text: "Forward-deployed engineers co-define scenarios, integrate systems, and harden Skills plus governance." },
      { icon: "shield", title: "How to choose", text: "Growth → credit marketing; stability → ops decisioning; org-wide change → start with FDE and a governance baseline." },
    ];
---
<Base lang={lang} pathname={pathname} pageKey="solutions">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="eyebrow">{s.eyebrow}</span>
      <h1 class="page-hero__title">{s.title}</h1>
      <p class="page-hero__sub">{s.sub}</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__head section__head--center">
        <span class="eyebrow">{zh ? "解决方案" : "Solutions"}</span>
        <h2 class="section__title">{zh ? "面向金融与企业的三条落地路径" : "Three paths for finance and enterprise"}</h2>
      </div>
      <div class="grid grid--2 reveal">
        {scenarios.map((sc) => (
          <article class="card">
            <div class="card__icon">
              <Icon name={sc.icon} size={26} />
            </div>
            <h3 class="card__title">{sc.title}</h3>
            <p class="card__text">{sc.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head section__head--center">
        <span class="eyebrow">{zh ? "客户案例" : "Customer stories"}</span>
        <h2 class="section__title">{zh ? "试点与落地，比口号更有说服力" : "Pilots and production over slogans"}</h2>
        <p class="section__sub">{zh ? "以下仅陈述已确认的合作与能力范围，不虚构量化指标。" : "Only confirmed engagements and capability scope — no invented metrics."}</p>
      </div>
      <div class="grid grid--2 reveal">
        {s.cases.map((item) => (
          <article class="card">
            <div class="card__case-head">
              <span class="tag">{item.industry}</span>
              {item.placeholder && <span class="tag tag--accent">{zh ? "示例案例" : "Sample case"}</span>}
            </div>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__text">{item.text}</p>
          </article>
        ))}
      </div>
      {s.note && <p class="solutions__note reveal">{s.note}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <h2 class="cta-band__title">{zh ? "你的业务场景，也能用 Noesis 落地" : "Your business scenario can run on Noesis too"}</h2>
          <p class="cta-band__text">{zh ? "把你想解决的问题告诉我们，我们为你规划专属方案。" : "Tell us the problem you want to solve and we will map a dedicated plan for you."}</p>
        </div>
        <div class="cta-band__actions">
          <a href={zh ? "/contact/" : "/en/contact/"} class="btn btn--accent">
            {s.cta}
            <span class="btn__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .card__case-head {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }
  .solutions__note {
    margin-top: 24px;
    text-align: center;
    font-size: 13px;
    color: var(--ink-faint);
  }
</style>
