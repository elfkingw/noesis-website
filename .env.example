# Public site origin used for canonical URLs and Open Graph.
# Example: https://noesis.example.com
# GitHub Pages preview: https://elfkingw.github.io/noesis-website
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set automatically by `npm run build:pages` for the GitHub Pages static export.
# Do not set for normal Vercel / `npm run build` (keeps /api/contact available).
# GITHUB_PAGES=true
# NEXT_PUBLIC_STATIC_EXPORT=true

# Optional: POST JSON demo requests to your CRM / Feishu / Slack / Zapier / custom API.
# If unset, submissions succeed and are logged on the server (not for production leads).
# Not used on GitHub Pages static preview.
CONTACT_WEBHOOK_URL=

# Optional bearer token sent as Authorization: Bearer <token>
CONTACT_WEBHOOK_TOKEN=
