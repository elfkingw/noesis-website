---
import type { L } from "@/data/content";

interface Props {
  lang: L;
  title: string;
  text: string;
  cta: string;
  ctaHref: string;
}

const { lang, title, text, cta, ctaHref } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2 class="cta-band__title">{title}</h2>
        <p class="cta-band__text">{text}</p>
      </div>
      <div class="cta-band__actions">
        <a href={ctaHref} class="btn btn--accent">
          {cta}
          <span class="btn__arrow">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
