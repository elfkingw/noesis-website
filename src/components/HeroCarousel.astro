---
import type { HeroSlide } from "@/data/content";
import { withBase } from "@/lib/paths";

interface Props {
  slides: HeroSlide[];
  label: string;
  prevLabel: string;
  nextLabel: string;
  imageLabel: string;
  videoLabel: string;
}

const { slides, label, prevLabel, nextLabel, imageLabel, videoLabel } = Astro.props;
---
<div class="hero-carousel" data-hero-carousel tabindex="0" role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="hero-carousel__stage">
    <button class="hero-carousel__arrow hero-carousel__arrow--prev" type="button" data-prev aria-label={prevLabel}>‹</button>
    <div class="hero-carousel__viewport" data-viewport>
      {slides.map((slide, index) => (
        <article class="hero-carousel__slide" data-slide data-kind={slide.kind} aria-hidden={index === 0 ? "false" : "true"}>
          {slide.kind === "video" ? (
            <video
              src={withBase(slide.src)}
              poster={slide.poster ? withBase(slide.poster) : undefined}
              muted
              playsinline
              preload="metadata"
            />
          ) : (
            <img src={withBase(slide.src)} alt="" />
          )}
          <div class="hero-carousel__shade"></div>
          <p class="hero-carousel__caption">
            <small>{String(index + 1).padStart(2, "0")} {slide.kind === "video" ? videoLabel : imageLabel}</small>
            <strong>{slide.title}</strong>
            <span>{slide.text}</span>
          </p>
          {slide.kind === "video" && <span class="hero-carousel__badge">{videoLabel}</span>}
        </article>
      ))}
    </div>
    <button class="hero-carousel__arrow hero-carousel__arrow--next" type="button" data-next aria-label={nextLabel}>›</button>
  </div>
  <div class="hero-carousel__dots" role="tablist" aria-label={label}>
    {slides.map((slide, index) => (
      <button class="hero-carousel__dot" type="button" role="tab" data-dot aria-label={slide.title} aria-selected={index === 0 ? "true" : "false"}></button>
    ))}
  </div>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-hero-carousel]");

  roots.forEach((root) => {
    const viewport = root.querySelector<HTMLElement>("[data-viewport]");
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    if (!viewport || slides.length === 0 || !prev || !next) return;

    let index = 0;
    let timer = 0;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    viewport.classList.toggle("is-reduced", reduced);

    const playVideo = (slide: HTMLElement, active: boolean) => {
      const video = slide.querySelector("video");
      if (!video) return;
      if (active) {
        video.play().catch(() => {});
      } else {
        video.pause();
        video.currentTime = 0;
      }
    };

    const render = (nextIndex: number) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const offset = i - index;
        slide.style.transform = `translateX(${offset * 100}%)`;
        const active = offset === 0;
        slide.setAttribute("aria-hidden", String(!active));
        playVideo(slide, active);
      });
      dots.forEach((dot, i) => dot.setAttribute("aria-selected", String(i === index)));
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (reduced) return;
      timer = window.setInterval(() => render(index + 1), 7000);
    };

    prev.addEventListener("click", () => {
      render(index - 1);
      start();
    });
    next.addEventListener("click", () => {
      render(index + 1);
      start();
    });
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        render(i);
        start();
      });
    });

    let startX = 0;
    let dragging = false;
    viewport.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      dragging = true;
      startX = event.clientX;
    });
    viewport.addEventListener("pointerup", (event) => {
      if (!dragging) return;
      dragging = false;
      const delta = event.clientX - startX;
      if (Math.abs(delta) < 48) return;
      render(index + (delta < 0 ? 1 : -1));
      start();
    });
    viewport.addEventListener("pointercancel", () => {
      dragging = false;
    });

    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        render(index - 1);
        start();
      } else if (event.key === "ArrowRight") {
        render(index + 1);
        start();
      }
    });
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) start();
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    render(0);
    start();
  });
</script>

<style>
  .hero-carousel {
    margin-top: 32px;
    outline: none;
  }
  .hero-carousel:focus-visible {
    outline: 3px solid rgba(157, 180, 255, 0.7);
    outline-offset: 6px;
    border-radius: 18px;
  }
  .hero-carousel__stage {
    position: relative;
  }
  .hero-carousel__viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 8;
    max-height: 440px;
    border-radius: 18px;
    background: #101a33;
    box-shadow: 0 18px 40px rgba(5, 10, 24, 0.28);
  }
  .hero-carousel__viewport.is-reduced .hero-carousel__slide {
    transition: none;
  }
  .hero-carousel__slide {
    position: absolute;
    inset: 0;
    transition: transform 0.5s cubic-bezier(0.22, 0.8, 0.2, 1);
  }
  .hero-carousel__slide img,
  .hero-carousel__slide video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-carousel__shade {
    position: absolute;
    inset: auto 0 0;
    height: 46%;
    background: linear-gradient(180deg, transparent, rgba(8, 14, 28, 0.78));
  }
  .hero-carousel__caption {
    position: absolute;
    left: 28px;
    right: 88px;
    bottom: 22px;
    margin: 0;
    color: #fff;
  }
  .hero-carousel__caption small {
    display: block;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: #b9c8ff;
  }
  .hero-carousel__caption strong {
    display: block;
    margin-top: 4px;
    font-size: 26px;
    letter-spacing: -0.02em;
  }
  .hero-carousel__caption span {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    color: #d5e0f6;
  }
  .hero-carousel__badge {
    position: absolute;
    top: 16px;
    right: 16px;
    height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--navy);
    font-size: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
  }
  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    color: var(--navy);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }
  .hero-carousel__arrow--prev { left: 12px; }
  .hero-carousel__arrow--next { right: 12px; }
  .hero-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-top: 14px;
  }
  .hero-carousel__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }
  .hero-carousel__dot[aria-selected="true"] {
    width: 22px;
    background: #fff;
  }
  @media (max-width: 720px) {
    .hero-carousel {
      margin-top: 24px;
    }
    .hero-carousel__viewport {
      aspect-ratio: 16 / 10;
      border-radius: 14px;
    }
    .hero-carousel__caption {
      left: 16px;
      right: 16px;
      bottom: 14px;
    }
    .hero-carousel__caption strong {
      font-size: 20px;
    }
    .hero-carousel__caption span {
      font-size: 13px;
    }
    .hero-carousel__arrow {
      width: 40px;
      height: 40px;
      margin-top: -20px;
    }
  }
</style>
