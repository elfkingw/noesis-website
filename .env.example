# Public site origin used for canonical URLs and Open Graph.
# Example: https://noesis.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: POST JSON demo requests to your CRM / Feishu / Slack / Zapier / custom API.
# If unset, submissions succeed and are logged on the server (not for production leads).
CONTACT_WEBHOOK_URL=

# Optional bearer token sent as Authorization: Bearer <token>
CONTACT_WEBHOOK_TOKEN=
