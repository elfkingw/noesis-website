---
import Nav from "@/components/Nav.astro";
import Icon from "@/components/Icon.astro";
import "@/styles/global.css";
import { withBase } from "@/lib/paths";
import { langFromPath } from "@/data/content";

const lang = langFromPath(Astro.url.pathname);
const zh = lang === "zh";
const pathname = "/404/";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{zh ? "页面未找到 — Noesis" : "Page not found — Noesis"}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  </head>
  <body>
    <Nav lang={lang} pathname={pathname} />
    <main>
      <section class="nf">
        <div class="container nf__inner">
          <div class="nf__code">404</div>
          <h1 class="nf__title">{zh ? "这个页面不存在" : "This page doesn’t exist"}</h1>
          <p class="nf__text">{zh ? "你访问的地址可能已变更或被移动。" : "The address you visited may have moved or no longer exists."}</p>
          <a href={withBase(lang === "zh" ? "/" : "/en/")} class="btn btn--primary btn--lg">
            <Icon name="arrow" size={18} />
            {zh ? "返回首页" : "Back to home"}
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .nf {
    min-height: 60vh;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .nf__code {
    font-size: 72px;
    font-weight: 800;
    color: var(--brand);
    opacity: 0.35;
    line-height: 1;
  }
  .nf__title {
    font-size: 28px;
    margin: 12px 0 8px;
  }
  .nf__text {
    color: var(--ink-soft);
    margin-bottom: 26px;
  }
</style>
